# PROVENANCE — Environment Variables

# Deployer wallet (generate with `cast wallet new`)
DEPLOYER_PRIVATE_KEY=0x...
DEPLOYER_ADDRESS=0x...

# Deployed DossierRegistry contract
REGISTRY_ADDRESS=0xd1534d20006248f4c2c290F83e6377b4A06037A9

# Optional: Claude API for live narrative generation (pre-generated narratives work without this)
ANTHROPIC_API_KEY=

# API server port (default: 3000)
PORT=3000
